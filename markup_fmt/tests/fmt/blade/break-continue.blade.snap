---
source: markup_fmt/tests/fmt.rs
---
<ul>
  @foreach ($users as $user)
    @if ($user->type == 1)
      @continue
    @endif
    <li>{{ $user->name }}</li>
    @if ($user->number == 5)
      @break
    @endif
    @continue($user->isGuest())
    @break($loop->iteration > 10)
    @break(2)
    @continue(1)
  @endforeach
</ul>
